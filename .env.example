# Telegram bot token (@BotFather dan olinadi)
TELEGRAM_TOKEN=your_bot_token_here

# JWT kaliti (tasodifiy uzun string)
JWT_SECRET=your_very_long_random_secret_here

# Servislararo himoya kaliti — MAJBURIY (bo'sh qoldirilsa, mutating endpointlar himoyasiz qoladi!)
# Generatsiya: openssl rand -hex 32
INTERNAL_TOKEN=your_random_internal_token_here

# Web sayt / mini-app bazaviy URL (HTTPS bo'lishi shart, Web App tugmasi uchun)
TV_BASE_URL=https://billiardking.uz

# Jonli efir to'xtagach yozuv avtomatik yuboriladigan Telegram kanali
# (bot shu kanalda admin bo'lishi shart)
LIVE_RECORDING_CHANNEL=@billiardkingVD

# API kaliti (ixtiyoriy)
API_KEY=

# Superadmin Telegram ID lari (vergul bilan ajratilgan)
# ID ni bilish uchun @userinfobot ga /start yozing
SUPERADMIN_IDS=123456789,987654321

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=billiard_bot

# Bot to'g'ridan-to'g'ri ishga tushganda (Docker'siz)
DATABASE_DSN=host=localhost port=5432 user=postgres password=postgres dbname=billiard_bot sslmode=disable
